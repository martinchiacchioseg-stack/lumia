# =====================================================================
# LUMIA / PATITA ALIADA - VARIABLES DE ENTORNO REQUERIDAS
# =====================================================================

# 1. Base de datos Neon PostgreSQL (Requerido en producción / Vercel)
# Obtené la URL de conexión en tu consola de Neon (Connection String -> Pooled / Direct)
DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Secreto para firma de cookies de sesión HttpOnly (Mínimo 32 caracteres aleatorios)
SESSION_SECRET=genera-aqui-una-cadena-criptografica-aleatoria-de-minimo-32-caracteres

# 3. Configuración WebAuthn / Passkeys (FIDO2)
# RP_ID: Dominio del sitio (sin https:// ni puertos). Ej: localhost o lumia-pwa.vercel.app
RP_ID=localhost
# RP_ORIGIN: URL completa del frontend. Ej: http://localhost:5173 o https://lumia-pwa.vercel.app
RP_ORIGIN=http://localhost:5173

# 4. Asistente de IA "Patita Aliada" (Google Gemini)
# Obtené tu clave en Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-1.5-flash

# 5. Configuración de Supabase (Opcional si se utiliza cliente frontend directo)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
